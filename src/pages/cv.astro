---
import CVLayout from '../layouts/CVLayout.astro';
import JobEntry from '../components/JobEntry.astro';
---

<CVLayout title="Catherine Maglasang - CV">
  <div class="nav-row">
    <a href="/cv/" class="nav-link">← Back to Home</a>
    <button class="nav-link" onclick="window.print()">Download PDF</button>
  </div>

  <div class="page">
    <!-- HEADER -->
    <div class="header">
      <img class="header-photo" src="/cv/catherine-photo.jpg" alt="Catherine Maglasang">
      <div class="header-text">
        <h1>Catherine Maglasang</h1>
        <div class="tagline">Full-Stack Engineer who ships AI-powered products and large-scale data systems.</div>
        <div class="contact">
          <span>cbmaglasang@gmail.com</span>
          <span>+63 927 970 3321</span>
          <span>Iligan City, Philippines</span>
        </div>
      </div>
    </div>

    <!-- SKILLS -->
    <div class="section">
      <div class="section-title">Technical Skills</div>
      <div class="skills-bar">
        <strong>Backend:</strong> TypeScript, Node.js, PHP/Laravel, Python, SQL (MySQL, PostgreSQL, Redshift), LoopBack 4 &middot;
        <strong>Frontend:</strong> React, Blade, JavaScript, MJML<br>
        <strong>AI/Cloud:</strong> AWS Bedrock (Claude), S3, Lambda, Step Functions, SQS, DynamoDB, RDS &middot; Prompt Engineering &middot; SSE Streaming<br>
        <strong>Practices:</strong> Security Hardening (SSRF, Auth, Input Validation) &middot; 790+ Automated Tests &middot; Git, Docker, Nginx, Agile/Scrum
      </div>
    </div>

    <!-- EXPERIENCE -->
    <div class="section">
      <div class="section-title">Experience</div>

      <JobEntry
        title="Full-Stack AI Developer"
        company="CliniqApps — Healthcare SaaS Platform"
        dateRange="Feb 2026 – Present"
        highlights={[
          'Designed and shipped an <strong>AI Newsletter Generator</strong> from zero to production - users paste a website URL and get 3 branded email template variants generated by AWS Bedrock (Claude), then refine via natural-language chat.',
          'Built the entire stack across <strong>3 repos</strong>: LoopBack 4 API (TypeScript), Laravel frontend (PHP/Blade), React email builder - with real-time SSE streaming (<strong>20+ event types</strong>) and background generation with polling to eliminate gateway timeouts.',
          'Engineered a <strong>fast refinement engine</strong> (8 programmatic handlers) that resolves color, font, text, spacing, and border changes without AI calls - cutting average edit time from ~8s to under 200ms.',
          'Hardened security across <strong>12 vulnerability categories</strong>: SSRF protection with DNS pinning, path traversal prevention, magic-byte file validation, token-only auth, rate limiting, and error sanitization. Enforced via a 29-item checklist on every deploy.',
          'Delivered <strong>790+ automated tests</strong> and a 49-check end-to-end simulation script covering security, tool gating, undo/redo, auto-save, session resume, and full AI conversation flows.'
        ]}
      />

      <JobEntry
        title="PTX Analytics Team Lead"
        company="Jarvis Analytics, Henry Schein One"
        dateRange="Aug 2024 – Feb 2026"
        highlights={[
          'Led a development team delivering financial and patient analytics used by thousands of dental practices - <strong>46 report modules</strong>, <strong>48,000+ SQL queries</strong>, <strong>14 practice management systems</strong>.',
          'Contributed to a <strong>unified reporting database</strong> standardizing schemas across all 14 PMS platforms. Owned the <strong>ODS schema mapping</strong> for Redshift cloud-scale analytics.',
          'Designed <strong>Matchback lead tracking</strong> stored procedures - linking marketing campaigns to patient acquisition to measure ROI for clients.',
          'Resolved SQL performance bottlenecks on high-volume queries, significantly improving report load times. Mentored developers on architecture and delivery standards.'
        ]}
      />

      <JobEntry
        title="Lead Query Developer"
        company="Jarvis Analytics Philippines OPC"
        dateRange="Jul 2021 – Aug 2024"
        highlights={[
          'Reverse-engineered <strong>14 PMS platforms</strong> (Dentrix, Eaglesoft, Open Dental, Denticon, Dentrix Ascend, Cloud 9, AbelDent, Power Practice, PBS Endo, OMS Vision, Ortho2, Focus Ortho, Denterprise, Tracker) - extracting and standardizing financial data across <strong>3,000+ queries per system</strong>.',
          'Built the <strong>Dentrix Ascend data sync pipeline</strong> in Python: syncs <strong>40+ API endpoints</strong> into <strong>51 database tables</strong> via AWS Step Functions, Lambda, and SQS - with full, incremental, and real-time streaming modes.',
          'Delivered reports across revenue tracking, aging receivables, production vs. collection, EOD, payroll, KPIs, and growth analytics. Led task delegation and cross-team coordination.'
        ]}
      />

      <JobEntry
        title="Web Developer"
        company="Mesasix Inc. Philippines"
        dateRange="May 2018 – Jun 2021"
        highlights={[
          'Built backend solutions including database design, stored procedures, and query optimization for business applications.',
          'Reverse-engineered legacy schemas and improved system performance and maintainability.'
        ]}
      />
    </div>

    <!-- EDUCATION -->
    <div class="section">
      <div class="section-title">Education</div>
      <div class="edu-row">
        <span class="edu-title">BS Computer Science, Major in Software Engineering</span>
        <span class="edu-date">2013 – 2018</span>
      </div>
      <div class="edu-school">Mindanao State University - Iligan Institute of Technology</div>
    </div>
  </div>
</CVLayout>

<style>
  .nav-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 210mm;
    margin: 20px auto 20px;
    padding: 0;
  }

  .nav-link {
    font-size: 13px;
    font-weight: 500;
    color: #555;
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: #1a1a1a;
    text-decoration: underline;
  }

  .page {
    width: 210mm;
    min-height: 297mm;
    margin: 10px auto 20px;
    background: #fff;
    padding: 40px 48px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }

  /* Header */
  .header {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 2.5px solid #1a1a1a;
  }

  .header-photo {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .header-text { flex: 1; }

  .header-text h1 {
    font-size: 19pt;
    font-weight: 700;
    color: #1a1a1a;
    letter-spacing: -0.5px;
    margin-bottom: 1px;
  }

  .header-text .tagline {
    font-size: 9.5pt;
    color: #444;
    margin-bottom: 5px;
  }

  .header-text .contact {
    font-size: 7.5pt;
    color: #777;
  }

  .header-text .contact a {
    color: #777;
    text-decoration: none;
  }

  .header-text .contact span { margin-right: 12px; }

  /* Sections */
  .section { margin-bottom: 28px; }

  .section-title {
    font-size: 8.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    color: #1a1a1a;
    margin-bottom: 12px;
    padding-bottom: 5px;
    border-bottom: 1px solid #d0d0d0;
  }

  /* Skills */
  .skills-bar {
    font-size: 8pt;
    color: #333;
    line-height: 1.65;
  }

  .skills-bar strong {
    color: #1a1a1a;
  }

  /* Education */
  .edu-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .edu-title {
    font-size: 9pt;
    font-weight: 600;
    color: #1a1a1a;
  }

  .edu-date {
    font-size: 7.5pt;
    color: #888;
  }

  .edu-school {
    font-size: 8pt;
    color: #555;
  }

  /* Print */
  @media print {
    .nav-row {
      display: none;
    }

    .page {
      margin: 0;
      padding: 24px 28px;
      box-shadow: none;
      width: 100%;
      min-height: auto;
    }
  }
</style>
