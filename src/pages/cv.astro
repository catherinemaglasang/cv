---
import CVLayout from '../layouts/CVLayout.astro';
import JobEntry from '../components/JobEntry.astro';
---

<CVLayout title="Catherine Maglasang - CV">
  <div class="nav-row">
    <a href="/cv/" class="nav-link">← Back to Home</a>
    <button class="nav-link" onclick="window.print()">Download PDF</button>
  </div>

  <div class="page">
    <!-- HEADER -->
    <div class="header">
      <img class="header-photo" src="/cv/catherine-photo.jpg" alt="Catherine Maglasang">
      <div class="header-text">
        <h1>Catherine Maglasang</h1>
        <div class="tagline">Technology Project Management | Delivery Leadership | Data & Software Systems</div>
        <div class="contact">
          <span>cbmaglasang@gmail.com</span>
          <span>+63 927 970 3321</span>
          <span>Iligan City, Philippines</span>
        </div>
      </div>
    </div>

    <!-- SUMMARY -->
    <div class="section">
      <div class="section-title">Professional Summary</div>
      <div class="summary">
        Technology and analytics leader with 8+ years of experience delivering software, data integration, and business intelligence solutions, including 5+ years in technical leadership. Experienced in coordinating cross-functional delivery from requirements gathering and planning through development, testing, release, and continuous improvement. Led an engineering team of 8 developers and supported large-scale analytics solutions spanning 14 dental practice management platforms and thousands of practices. Combines structured delivery practices, stakeholder coordination, technical problem-solving, and process improvement to keep complex work moving. Seeking to bring this experience into a technology project management role.
      </div>
    </div>

    <!-- CORE COMPETENCIES -->
    <div class="section">
      <div class="section-title">Core Competencies</div>
      <div class="skills-bar">
        <strong>Project & Delivery Management:</strong> Project Planning, Requirements Gathering, Scope Coordination, Task Delegation, Delivery Tracking, Risk and Issue Resolution, Continuous Improvement<br>
        <strong>Team & Stakeholder Leadership:</strong> Team Leadership, Resource Coordination, Cross-Functional Collaboration, Stakeholder Communication, Mentoring, Scrum Facilitation<br>
        <strong>Delivery Methods & Tools:</strong> Agile/Scrum, Jira, Confluence, Project Documentation, Technical Documentation, Testing and Release Coordination<br>
        <strong>Financial & Business Analytics:</strong> Financial Reporting, Data Analysis, Revenue Tracking, Production vs. Collection, Accounts Receivable & Aging, KPI Dashboards, Growth Analytics, ROI Measurement, Report Reverse Engineering<br>
        <strong>Data & Technology:</strong> SQL (MySQL, PostgreSQL, Redshift), Python, API Integrations, AWS (Lambda, Step Functions, SQS, S3), Database Architecture, Data Pipelines, Reporting Systems, Excel, Google Sheets, Docker, Git
      </div>
    </div>

    <!-- EXPERIENCE -->
    <div class="section">
      <div class="section-title">Experience</div>

      <JobEntry
        title="PTX Analytics Team Lead"
        company="Jarvis Analytics, Henry Schein One"
        dateRange="Aug 2024 – Feb 2026"
        tech="Team Leadership, Scrum Master, Project Coordination, SQL, AWS Redshift, KPI Dashboards"
        highlights={[
          'Led a <strong>team of 8 query developers</strong> as Scrum Master, coordinating delivery of financial and patient analytics used by thousands of dental practices across <strong>14 practice management systems</strong>, <strong>46 report modules</strong>, and <strong>48,000+ SQL queries</strong>.',
          'Coordinated reporting initiatives across multiple platforms, balancing development priorities, technical requirements, and reporting accuracy.',
          'Mentored developers on <strong>Dentrix Ascend</strong> architecture, data models, and reporting workflows, strengthening team capability and knowledge sharing.',
          'Contributed to a <strong>unified reporting database</strong> standardizing schemas across all 14 platforms and owned the <strong>ODS schema mapping</strong> for Redshift analytics.',
          'Designed <strong>Matchback lead-tracking</strong> stored procedures linking marketing campaigns to patient acquisition to measure client ROI.',
          'Resolved high-volume SQL performance bottlenecks, improving report load times.'
        ]}
      />

      <JobEntry
        title="Lead Query Developer"
        company="Jarvis Analytics Philippines OPC"
        dateRange="Jul 2021 – Aug 2024"
        tech="Project Coordination, Dentrix Ascend, Python, API Integrations, AWS Lambda, Step Functions, SQS"
        highlights={[
          'Built the <strong>Dentrix Ascend data integration pipeline</strong> in Python, synchronizing <strong>40+ API endpoints</strong> into <strong>51 database tables</strong> using AWS Step Functions, Lambda, and SQS, with full, incremental, and real-time synchronization modes.',
          'Reverse-engineered <strong>Dentrix Ascend clinical and financial workflows</strong>, mapping treatment plans, appointments, procedures, insurance claims, and patient payments to reporting requirements to support data accuracy across the patient lifecycle.',
          'Reverse-engineered and standardized data structures across <strong>14 practice management systems</strong>, working with more than <strong>3,000 queries per system</strong>.',
          'Delivered reporting capabilities across <strong>revenue tracking, accounts receivable and aging, production versus collections, end-of-day reporting, payroll, KPIs, and growth analytics</strong>.',
          'Led task delegation and cross-team coordination to support reporting development and delivery.'
        ]}
      />

      <JobEntry
        title="Full-Stack AI Developer"
        company="CliniqApps, Healthcare SaaS Platform"
        dateRange="Feb 2026 – May 2026"
        tech="TypeScript, Node.js, PHP/Laravel, React, AWS Bedrock (Claude), Docker"
        highlights={[
          'Shipped an <strong>AI Newsletter Generator</strong> from initial development to production across <strong>3 repositories</strong>, incorporating real-time streaming and background generation.',
          'Delivered <strong>790+ automated tests</strong> and a <strong>29-item deployment checklist</strong> covering 12 vulnerability categories.'
        ]}
      />

      <JobEntry
        title="Founder / Full-Stack Developer"
        company="Nature Nook Cafe"
        dateRange="Aug 2023 – Present"
        tech="Business Operations, Python, FastAPI, React, Docker, Shopify"
        highlights={[
          'Built and deployed a full-stack <strong>cost calculator</strong> supporting menu costing, ingredient tracking, equipment depreciation, and financial reporting across <strong>15+ database tables</strong>.',
          'Established a <strong>Shopify storefront</strong> for online ordering and launched the business end to end.',
          'Managed business development and day-to-day operations alongside software development responsibilities.'
        ]}
      />

      <JobEntry
        title="Web Developer"
        company="Mesasix Inc. Philippines"
        dateRange="May 2018 – Jun 2021"
        tech="Backend Development, Database Design, SQL"
        highlights={[
          'Built backend solutions for dental practice management systems, including database design, stored procedures, and query optimization.',
          'Reverse-engineered legacy database schemas and improved system performance and maintainability.'
        ]}
      />
    </div>

    <!-- EDUCATION -->
    <div class="section">
      <div class="section-title">Education</div>
      <div class="edu-row">
        <span class="edu-title">BS Computer Science, Major in Software Engineering</span>
        <span class="edu-date">2013 – 2018</span>
      </div>
      <div class="edu-school">Mindanao State University - Iligan Institute of Technology</div>
    </div>
  </div>
</CVLayout>

<style>
  .nav-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 210mm;
    margin: 20px auto 20px;
    padding: 0;
  }

  .nav-link {
    font-size: 13px;
    font-weight: 500;
    color: #555;
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: #1a1a1a;
    text-decoration: underline;
  }

  .page {
    width: 210mm;
    min-height: 297mm;
    margin: 10px auto 20px;
    background: #fff;
    padding: 40px 48px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  }

  /* Header */
  .header {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 2.5px solid #1a1a1a;
  }

  .header-photo {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .header-text { flex: 1; }

  .header-text h1 {
    font-size: 19pt;
    font-weight: 700;
    color: #1a1a1a;
    letter-spacing: -0.5px;
    margin-bottom: 1px;
  }

  .header-text .tagline {
    font-size: 9.5pt;
    color: #444;
    margin-bottom: 5px;
  }

  .header-text .contact {
    font-size: 7.5pt;
    color: #777;
  }

  .header-text .contact a {
    color: #777;
    text-decoration: none;
  }

  .header-text .contact span { margin-right: 12px; }

  /* Sections */
  .section { margin-bottom: 18px; }

  /* Summary */
  .summary {
    font-size: 8pt;
    color: #333;
    line-height: 1.7;
    text-align: justify;
    text-indent: 2em;
  }

  .section-title {
    font-size: 8.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    color: #1a1a1a;
    margin-bottom: 12px;
    padding-bottom: 5px;
    border-bottom: 1px solid #d0d0d0;
  }

  /* Skills */
  .skills-bar {
    font-size: 8pt;
    color: #333;
    line-height: 1.65;
  }

  .skills-bar strong {
    color: #1a1a1a;
  }

  /* Education */
  .edu-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .edu-title {
    font-size: 9pt;
    font-weight: 600;
    color: #1a1a1a;
  }

  .edu-date {
    font-size: 7.5pt;
    color: #888;
  }

  .edu-school {
    font-size: 8pt;
    color: #555;
  }

  /* Print */
  @media print {
    .nav-row {
      display: none;
    }

    .page {
      margin: 0;
      padding: 24px 28px;
      box-shadow: none;
      width: 100%;
      min-height: auto;
    }
  }
</style>
