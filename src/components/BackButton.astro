---
interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'dark' } = Astro.props;
---

<a href="/cv/" class={`back-btn back-btn-${variant}`}>Back to Home</a>

<style>
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    text-decoration: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.2s;
  }

  .back-btn::before {
    content: '←';
    font-size: 18px;
  }

  /* Light variant (for CV page) */
  .back-btn-light {
    padding: 8px 16px;
    margin: 20px auto 0;
    background: #1a1a1a;
    color: #fff;
    border-radius: 6px;
    font-size: 13px;
    max-width: 210mm;
    display: block;
    width: fit-content;
  }

  .back-btn-light:hover {
    background: #333;
  }

  .back-btn-light::before {
    font-size: 16px;
  }

  /* Dark variant (for ebook, code-walkthrough) */
  .back-btn-dark {
    position: fixed;
    top: 24px;
    left: 24px;
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(10px);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.2);
    z-index: 100;
  }

  .back-btn-dark:hover {
    background: rgba(255,255,255,0.25);
    border-color: rgba(255,255,255,0.4);
  }

  @media print {
    .back-btn {
      display: none;
    }
  }
</style>
