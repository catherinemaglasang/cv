---
interface Props {
  title: string;
  company: string;
  dateRange: string;
  tech?: string;
  highlights: string[];
}

const { title, company, dateRange, tech, highlights } = Astro.props;
const techItems = tech ? tech.split(',').map(t => t.trim()) : [];
---

<div class="job">
  <div class="job-row">
    <span class="job-title">{title}</span>
    <span class="job-date">{dateRange}</span>
  </div>
  <div class="job-company">{company}</div>
  {techItems.length > 0 && (
    <div class="job-tech">
      {techItems.map(t => <span class="tech-pill">{t}</span>)}
    </div>
  )}
  <ul>
    {highlights.map(item => (
      <li set:html={item} />
    ))}
  </ul>
</div>

<style>
  .job { margin-bottom: 20px; }
  .job:last-child { margin-bottom: 0; }

  .job-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .job-title {
    font-size: 9.5pt;
    font-weight: 700;
    color: #1a1a1a;
  }

  .job-date {
    font-size: 8.5pt;
    color: #888;
    white-space: nowrap;
    display: inline-block;
    vertical-align: top;
  }

  .job-company {
    font-size: 8.5pt;
    color: #555;
    margin-bottom: 4px;
    font-style: italic;
    display: inline-block;
    vertical-align: top;
  }

  .job-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 10px;
  }

  .tech-pill {
    font-size: 6.5pt;
    color: #444;
    background: #f0f0f0;
    padding: 1px 7px;
    border-radius: 3px;
    white-space: nowrap;
  }

  .job ul {
    padding-left: 14px;
    margin-top: 4px;
  }

  .job li {
    font-size: 8pt;
    color: #333;
    margin-bottom: 5px;
    line-height: 1.7;
  }

  .job li :global(strong) {
    color: #1a1a1a;
  }
</style>
